<?xml version="1.0"?>
<package format="2">
  <name>seliSlam</name>
  <version>0.1.0</version>
  <description>
    SeLiSLAM: Semantic Lifelong SLAM for UAVs.
    Combines continual VIO, open-vocabulary segmentation,
    semantic ephemerality, BYE object re-ID, and long-term
    map management in a ROS Noetic pipeline.
  </description>

  <maintainer email="thanh@jaist.ac.jp">Thanh Nguyen Canh</maintainer>
  <license>MIT</license>

  <!-- Build tool -->
  <buildtool_depend>catkin</buildtool_depend>

  <!-- Core ROS dependencies -->
  <depend>rospy</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>

  <!-- Image pipeline -->
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>
  <depend>depth_image_proc</depend>

  <!-- Point cloud -->
  <depend>pcl_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>sensor_msgs</depend>

  <!-- Message generation -->
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>

  <!-- Python deps (resolved at runtime via pip, listed here for documentation) -->
  <!-- torch, torchvision, numpy, scipy, open3d, transformers, timm -->
</package>
