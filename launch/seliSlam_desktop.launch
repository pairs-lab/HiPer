<!--
seliSlam_desktop.launch
=======================
Full SeLiSLAM pipeline for desktop development
(RTX GPU, Python 3.8 ROS environment, direct model inference).

Usage:
  roslaunch seliSlam seliSlam_desktop.launch [bag:=path/to/bag.bag]

Optionally replay a RealSense bag:
  roslaunch seliSlam seliSlam_desktop.launch \
    bag:=/data/flight01.bag session_id:=3
-->
<launch>

  <!-- ── Arguments ─────────────────────────────────────────────────── -->
  <arg name="config"      default="$(find seliSlam)/config/params_desktop.yaml"/>
  <arg name="session_id"  default="0"/>
  <arg name="bag"         default=""/>
  <arg name="rviz"        default="true"/>
  <arg name="map_dir"     default="$(env HOME)/.seliSlam/maps"/>

  <!-- ── Load parameters ───────────────────────────────────────────── -->
  <rosparam file="$(arg config)" command="load" ns="/seliSlam"/>
  <param name="/seliSlam/session_id"       value="$(arg session_id)"/>
  <param name="/seliSlam/map_mgr/map_save_dir" value="$(arg map_dir)"/>

  <!-- ── Optional bag replay ───────────────────────────────────────── -->
  <group if="$(eval arg('bag') != '')">
    <node pkg="rosbag" type="play" name="bag_player"
          args="--clock --loop $(arg bag)"
          output="screen"/>
    <param name="/use_sim_time" value="true"/>
  </group>

  <!-- ── VIO front-end ─────────────────────────────────────────────── -->
  <node pkg="seliSlam" type="vio_frontend_node.py"
        name="vio_frontend" output="screen">
    <remap from="/camera/color/image_raw"
           to="/camera/color/image_raw"/>
    <remap from="/camera/depth/image_rect_raw"
           to="/camera/depth/image_rect_raw"/>
  </node>

  <!-- ── Segmentation ──────────────────────────────────────────────── -->
  <node pkg="seliSlam" type="segmentation_node.py"
        name="segmentation" output="screen">
    <!-- Desktop: direct inference, no socket bridge -->
    <param name="seg/use_socket_bridge" value="false"/>
    <param name="seg/device"            value="cuda"/>
  </node>

  <!-- ── Ephemerality ──────────────────────────────────────────────── -->
  <node pkg="seliSlam" type="ephemerality_node.py"
        name="ephemerality" output="screen"/>

  <!-- ── Object encoder ────────────────────────────────────────────── -->
  <node pkg="seliSlam" type="object_encoder_node.py"
        name="object_encoder" output="screen">
    <param name="encoder/backbone"  value="dgcnn"/>
    <param name="encoder/embed_dim" value="256"/>
  </node>

  <!-- ── Map manager ───────────────────────────────────────────────── -->
  <node pkg="seliSlam" type="map_manager_node.py"
        name="map_manager" output="screen">
    <param name="map_mgr/map_save_dir" value="$(arg map_dir)"/>
  </node>

  <!-- ── Static transforms (identity for desktop sim) ─────────────── -->
  <node pkg="tf2_ros" type="static_transform_publisher"
        name="camera_to_base"
        args="0 0 0 0 0 0 base_link camera_color_optical_frame"/>

  <!-- ── RViz ──────────────────────────────────────────────────────── -->
  <group if="$(arg rviz)">
    <node pkg="rviz" type="rviz" name="rviz"
          args="-d $(find seliSlam)/config/seliSlam.rviz"
          output="screen"/>
  </group>

</launch>
